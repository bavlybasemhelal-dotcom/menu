{
  "name": "souqna-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src tests scripts/*.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:rules": "node scripts/emulators.mjs rules",
    "test:e2e": "playwright test",
    "dev:emulator": "vite --mode emulator --host 127.0.0.1",
    "test:browser": "node scripts/emulators.mjs browser",
    "emulators": "node scripts/emulators.mjs start",
    "seed:emulator": "node scripts/seed-emulator.mjs"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "firebase-admin": "^14.5.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.10",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
