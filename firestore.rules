rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function allowedUid() { return '0HGm4QHaZ6gzUxjNfTVyKcHGXZr2'; }
    function isAdmin() { return allowedUid() != '__ADMIN_UID_NOT_CONFIGURED__' && request.auth != null && request.auth.uid == allowedUid(); }
    function validShop(id) { return id == 'main'; }
    function text(v, max) { return v is string && v.size() <= max; }
    function localized(v, max) { return v is map && v.keys().hasOnly(['ar','en']) && v.keys().hasAll(['ar','en']) && text(v.ar,max) && text(v.en,max); }
    function name(v) { return localized(v,200) && (v.ar.size()>0 || v.en.size()>0); }
    function money(v) { return v is int && v>=0 && v<=1000000000; }
    function optionalMoney(v) { return v == null || money(v); }
    function quantity(v) { return v==null || (v is int && v>0 && v<=100000); }
    function applies(d,unit) { return d.target==unit || d.target=='all' || (d.target=='both' && unit!='box'); }
    function pack(p) { return quantity(p.boxQuantity) && quantity(p.cartonBoxQuantity) && (p.boxPriceMinor==null && p.cartonPriceMinor==null || p.boxQuantity!=null) && (p.cartonPriceMinor==null || p.cartonBoxQuantity!=null); }
    function optionalId(v) { return v == null || (text(v,100) && v.size()>0); }
    function schedule(v) { return (v.startsAt == null || v.startsAt is timestamp) && (v.endsAt == null || v.endsAt is timestamp) && (v.startsAt == null || v.endsAt == null || v.endsAt>=v.startsAt); }
    function timestamps(v) { return v.createdAt is timestamp && v.updatedAt == request.time; }
    function state(v) { return v in ['draft','published','hidden']; }
    function publicUrl(v) { return v == null || (text(v,1500) && (v.matches('https://(drive[.]google[.]com/uc|drive[.]usercontent[.]google[.]com/download)[?]export=view&id=[a-zA-Z0-9_-]+(&resourcekey=[a-zA-Z0-9_-]+)?') || v.matches('https://script[.]google[.]com/macros/s/[a-zA-Z0-9_-]+/exec[?]action=image&fileId=[a-zA-Z0-9_-]+'))); }
    function bridgeConfig(v) { return v.get('driveProvider','apps_script') == 'apps_script' && text(v.get('googleEmail',''),254) && text(v.get('webAppUrl',''),500) && (v.get('webAppUrl','')=='' || v.webAppUrl.matches('https://script[.]google[.]com/macros/s/[a-zA-Z0-9_-]+/exec')) && v.get('scriptConnected',false) is bool && (v.get('lastTestedAt',null)==null || v.lastTestedAt is timestamp) && text(v.get('rootFolderId',''),200) && text(v.get('rootFolderName',''),200) && (v.get('storageUsedBytes',null)==null || (v.storageUsedBytes is int && v.storageUsedBytes>=0)) && (v.get('scriptConnected',false)==false || (v.get('webAppUrl','')!='' && v.get('rootFolderId','')!='' && v.get('lastTestedAt',null) is timestamp)); }
    function bridgeMedia(v) { return v.get('storageProvider','apps_script') == 'apps_script' && text(v.get('driveFolderId',''),200) && text(v.get('driveFolderName',''),200) && (v.get('driveDirectUrl','')=='' || publicUrl(v.driveDirectUrl)) && (v.get('driveDownloadUrl','')=='' || (text(v.driveDownloadUrl,1500) && v.driveDownloadUrl.matches('https://drive[.]google[.]com/uc[?]export=download&id=[a-zA-Z0-9_-]+'))); }
    function mediaReady(shop,id) { let m=get(/databases/$(database)/documents/shops/$(shop)/media/$(id)).data; return m.status=='public_test_passed' && m.publicShared==true && m.verifiedPublicAssetUrl!=null && publicUrl(m.verifiedPublicAssetUrl); }
    function imageAt(shop,v,n) { return v.imageMediaIds.size()<=n || mediaReady(shop,v.imageMediaIds[n]); }
    function imagesReady(shop,v) { return imageAt(shop,v,0) && imageAt(shop,v,1) && imageAt(shop,v,2) && imageAt(shop,v,3) && imageAt(shop,v,4) && imageAt(shop,v,5); }
    function discount(v) { return v==null || (v is map && v.keys().hasOnly(['kind','value','target','startsAt','endsAt']) && v.keys().hasAll(['kind','value','target','startsAt','endsAt']) && v.kind in ['percent','fixed'] && v.target in ['unit','box','carton','both','all'] && v.value is number && v.value>=0 && (v.kind=='percent' ? v.value<=100 : v.value is int) && schedule(v)); }
    function discountPrice(p) { return p.discount==null || ((p.discount.target!='unit'||p.unitPriceMinor!=null) && (p.discount.target!='box'||p.boxPriceMinor!=null) && (p.discount.target!='carton'||p.cartonPriceMinor!=null) && (p.discount.kind=='percent' || ((!applies(p.discount,'unit') || p.unitPriceMinor==null || p.discount.value<=p.unitPriceMinor) && (!applies(p.discount,'box') || p.boxPriceMinor==null || p.discount.value<=p.boxPriceMinor) && (!applies(p.discount,'carton') || p.cartonPriceMinor==null || p.discount.value<=p.cartonPriceMinor)))); }
    function variantAt(p,n) { return p.variants.size()<=n || (p.variants[n] is map && p.variants[n].keys().hasOnly(['id','label','kind','unitPriceMinor','available']) && text(p.variants[n].id,100) && name(p.variants[n].label) && p.variants[n].kind in ['size','color','option'] && optionalMoney(p.variants[n].unitPriceMinor) && p.variants[n].available is bool && (p.discount==null || p.discount.kind=='percent' || !applies(p.discount,'unit') || p.variants[n].unitPriceMinor==null || p.discount.value<=p.variants[n].unitPriceMinor)); }
    function variants(p) { return variantAt(p,0)&&variantAt(p,1)&&variantAt(p,2)&&variantAt(p,3)&&variantAt(p,4)&&variantAt(p,5)&&variantAt(p,6)&&variantAt(p,7)&&variantAt(p,8)&&variantAt(p,9)&&variantAt(p,10)&&variantAt(p,11); }
    function product(shop,p) { return p.keys().hasOnly(['name','description','categoryId','slug','status','availability','unitPriceMinor','boxPriceMinor','boxQuantity','cartonBoxQuantity','cartonPriceMinor','cartonQuantity','imageMediaIds','variants','discount','searchTokens','discountEligible','createdAt','updatedAt']) && name(p.name) && localized(p.description,4000) && text(p.categoryId,100) && p.categoryId.size()>0 && text(p.slug,200) && state(p.status) && p.availability in ['available','limited','unavailable'] && optionalMoney(p.unitPriceMinor) && optionalMoney(p.boxPriceMinor) && optionalMoney(p.cartonPriceMinor) && (p.unitPriceMinor!=null || p.boxPriceMinor!=null || p.cartonPriceMinor!=null) && pack(p) && (p.cartonQuantity==null || (p.cartonQuantity is int && p.cartonQuantity>0 && p.cartonQuantity<=100000)) && p.imageMediaIds is list && p.imageMediaIds.size()<=6 && p.variants is list && p.variants.size()<=12 && discount(p.discount) && discountPrice(p) && (p.discount==null || p.discount.target!='carton' || p.cartonPriceMinor!=null) && variants(p) && p.searchTokens is list && p.searchTokens.size()<=180 && p.discountEligible is bool && timestamps(p) && (p.status!='published' || (get(/databases/$(database)/documents/shops/$(shop)/categories/$(p.categoryId)).data.status=='published' && imagesReady(shop,p))); }
    function bundleItem(shop,o,n) { let i=o.bundleItems[n]; let p=get(/databases/$(database)/documents/shops/$(shop)/products/$(i.productId)).data; return i.keys().hasOnly(['productId','quantity','unit']) && text(i.productId,100) && i.quantity is int && i.quantity>0 && i.quantity<=100000 && i.unit in ['unit','box','carton'] && p.status=='published' && (i.unit!='unit'||p.unitPriceMinor!=null) && (i.unit!='box'||p.boxPriceMinor!=null) && (i.unit!='carton'||p.cartonPriceMinor!=null); }
    function bundleAt(shop,o,n) { return o.bundleItems.size()<=n || bundleItem(shop,o,n); }
    function bundleReady(shop,o) { return o.bundleItems.size()>0 && bundleAt(shop,o,0)&&bundleAt(shop,o,1)&&bundleAt(shop,o,2)&&bundleAt(shop,o,3)&&bundleAt(shop,o,4)&&bundleAt(shop,o,5); }
    match /shops/{shop} {
      allow get: if validShop(shop);
      allow create,update: if validShop(shop)&&isAdmin() && request.resource.data.keys().hasOnly(['name','description','logoMediaId','whatsappNumber','facebookUrl','currency','defaultLanguage','branding','updatedAt']) && name(request.resource.data.name) && localized(request.resource.data.description,4000) && optionalId(request.resource.data.logoMediaId) && (request.resource.data.logoMediaId==null||mediaReady(shop,request.resource.data.logoMediaId)) && request.resource.data.whatsappNumber.matches('^$|^[1-9][0-9]{6,14}$') && request.resource.data.facebookUrl.matches('^$|^https://(www[.]|m[.])?facebook[.]com/.*') && request.resource.data.currency in ['EGP','USD','SAR','AED','EUR'] && request.resource.data.defaultLanguage in ['ar','en'] && request.resource.data.branding.keys().hasOnly(['primary','accent']) && request.resource.data.branding.primary.matches('^#[0-9a-fA-F]{6}$') && request.resource.data.branding.accent.matches('^#[0-9a-fA-F]{6}$') && request.resource.data.updatedAt==request.time;
      match /categories/{id} {
        allow read: if validShop(shop)&&(isAdmin()||resource.data.status=='published');
        allow create,update: if validShop(shop)&&isAdmin() && request.resource.data.keys().hasOnly(['name','description','order','coverMediaId','status','createdAt','updatedAt']) && name(request.resource.data.name) && localized(request.resource.data.description,4000) && request.resource.data.order is int && request.resource.data.order>=0 && request.resource.data.order<=100000 && optionalId(request.resource.data.coverMediaId) && request.resource.data.status in ['published','hidden'] && timestamps(request.resource.data) && (request.resource.data.status!='published'||request.resource.data.coverMediaId==null||mediaReady(shop,request.resource.data.coverMediaId));
        allow delete: if validShop(shop)&&isAdmin();
      }
      match /products/{id} {
        allow read: if validShop(shop)&&(isAdmin()||resource.data.status=='published');
        allow create,update: if validShop(shop)&&isAdmin()&&product(shop,request.resource.data);
        allow delete: if validShop(shop)&&isAdmin();
      }
      match /offers/{id} {
        allow read: if validShop(shop)&&(isAdmin()||(resource.data.status=='published'&&resource.data.needsReview==false));
        allow create,update: if validShop(shop)&&isAdmin() && request.resource.data.keys().hasOnly(['type','status','name','description','conditions','imageMediaId','startsAt','endsAt','featured','displayOrder','placement','bundleItems','bundleFinalPriceMinor','needsReview','productIds','specialDisplayPriceMinor','callout','bundleProductIds','createdAt','updatedAt']) && request.resource.data.type in ['bundle','special'] && state(request.resource.data.status) && name(request.resource.data.name) && localized(request.resource.data.description,4000) && localized(request.resource.data.conditions,4000) && localized(request.resource.data.callout,4000) && optionalId(request.resource.data.imageMediaId) && schedule(request.resource.data) && request.resource.data.featured is bool && request.resource.data.displayOrder is int && request.resource.data.displayOrder>=0 && request.resource.data.displayOrder<=100000 && request.resource.data.placement in ['none','hero','strip'] && request.resource.data.bundleItems is list && request.resource.data.bundleItems.size()<=6 && request.resource.data.productIds is list && request.resource.data.productIds.size()<=6 && request.resource.data.bundleProductIds is list && request.resource.data.bundleProductIds.size()<=6 && request.resource.data.needsReview is bool && optionalMoney(request.resource.data.bundleFinalPriceMinor) && optionalMoney(request.resource.data.specialDisplayPriceMinor) && timestamps(request.resource.data) && (request.resource.data.status!='published'||(request.resource.data.needsReview==false && (request.resource.data.imageMediaId==null||mediaReady(shop,request.resource.data.imageMediaId)) && (request.resource.data.type!='bundle'||(money(request.resource.data.bundleFinalPriceMinor)&&bundleReady(shop,request.resource.data)))));
        allow delete: if validShop(shop)&&isAdmin();
      }
      match /media/{id} {
        allow read: if validShop(shop)&&(isAdmin()||(resource.data.status=='public_test_passed'&&resource.data.publicShared==true&&resource.data.publicUsedBy.size()>0));
        allow create,update: if validShop(shop)&&isAdmin() && request.resource.data.keys().hasOnly(['name','driveFileId','resourceKey','driveWebViewUrl','verifiedPublicAssetUrl','mimeType','sizeBytes','originalMediaId','storageProvider','driveDirectUrl','driveDownloadUrl','driveFolderId','driveFolderName','role','status','publicShared','anonymousRenderTestedAt','usedBy','publicUsedBy','createdAt','updatedAt']) && bridgeMedia(request.resource.data) && text(request.resource.data.name,200) && text(request.resource.data.driveFileId,200) && optionalId(request.resource.data.resourceKey) && request.resource.data.driveWebViewUrl.matches('^https://drive[.]google[.]com/.*') && publicUrl(request.resource.data.verifiedPublicAssetUrl) && text(request.resource.data.mimeType,100) && (!request.resource.data.keys().hasAny(['originalMediaId']) || optionalId(request.resource.data.originalMediaId)) && request.resource.data.sizeBytes is int && request.resource.data.sizeBytes>=0 && request.resource.data.sizeBytes<=10000000000 && request.resource.data.role in ['image','video','document','logo'] && request.resource.data.status in ['metadata_saved','public_test_passed','private','orphan','failed'] && request.resource.data.publicShared is bool && (request.resource.data.anonymousRenderTestedAt==null||request.resource.data.anonymousRenderTestedAt is timestamp) && request.resource.data.usedBy is list && request.resource.data.usedBy.size()<=200 && request.resource.data.publicUsedBy is list && request.resource.data.publicUsedBy.size()<=200 && timestamps(request.resource.data) && (request.resource.data.status!='public_test_passed'||(request.resource.data.publicShared==true&&request.resource.data.anonymousRenderTestedAt is timestamp&&request.resource.data.verifiedPublicAssetUrl!=null));
        allow delete: if validShop(shop)&&isAdmin()&&resource.data.usedBy.size()==0;
      }
    }
    match /privateShopConfig/{shop} {
      allow read: if validShop(shop)&&isAdmin();
      allow create,update: if validShop(shop)&&isAdmin() && request.resource.data.keys().hasOnly(['driveProvider','googleEmail','webAppUrl','scriptConnected','lastTestedAt','rootFolderId','rootFolderName','storageUsedBytes','maxImageBytes','maxVideoBytes','maxDocumentBytes','updatedAt']) && bridgeConfig(request.resource.data) && request.resource.data.maxImageBytes is int && request.resource.data.maxVideoBytes is int && request.resource.data.maxDocumentBytes is int && request.resource.data.maxImageBytes>=0 && request.resource.data.maxVideoBytes>=0 && request.resource.data.maxDocumentBytes>=0 && request.resource.data.maxImageBytes<=20971520 && request.resource.data.maxVideoBytes<=20971520 && request.resource.data.maxDocumentBytes<=20971520 && request.resource.data.updatedAt==request.time;
    }
  }
}


